# Ecowitt credentials (never commit real values)
APPLICATION_KEY=
API_KEY=
MAC_ADDRESS=

# Generate a unique token with at least 32 random bytes:
# py -3 -c "import secrets; print(secrets.token_urlsafe(48))"
RELAY_AUTH_TOKEN=

# Only these sensor paths are returned. Status metadata (code, msg, time) is
# included automatically.
ECOWITT_ALLOWED_FIELDS=data.outdoor.temperature,data.outdoor.humidity

# Per-process cap on authenticated Ecowitt requests.
RELAY_RATE_LIMIT_PER_MINUTE=30

# Request and upstream resource limits.
MAX_REQUEST_BYTES=16384
MAX_UPSTREAM_RESPONSE_BYTES=1048576
ECOWITT_CONNECT_TIMEOUT_SECONDS=3
ECOWITT_READ_TIMEOUT_SECONDS=10

# The development server is private by default. Set this deliberately only
# when a trusted reverse proxy must reach it.
HOST=127.0.0.1
PORT=5000
